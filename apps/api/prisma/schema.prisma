generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "crm", "iam", "inventory", "operation"]
}

model Lead {
  id             String       @id @default(cuid())
  source         LeadSource
  status         LeadStatus   @default(NEW)
  fullName       String
  email          String?
  phone          String?
  message        String?
  assetId        String?
  partyId        String?
  assignedTo     String?
  slaDueAt       DateTime?
  firstContactAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  qualifiedAt    DateTime?
  activities     Activity[]
  party          Party?       @relation(fields: [partyId], references: [id])
  opportunity    Opportunity?

  @@index([status])
  @@index([assignedTo])
  @@index([email])
  @@index([phone])
  @@map("lead")
  @@schema("crm")
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  type      ActivityType
  outcome   String?
  notes     String?
  createdBy String
  createdAt DateTime     @default(now())
  lead      Lead         @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("activity")
  @@schema("crm")
}

model Party {
  id        String    @id @default(cuid())
  type      PartyType
  email     String?   @unique
  phone     String?
  fullName  String?
  company   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  leads     Lead[]

  @@map("party")
  @@schema("crm")
}

model Opportunity {
  id           String           @id @default(cuid())
  leadId       String           @unique
  stage        OpportunityStage @default(NEW)
  amount       Decimal?
  currency     String           @default("PEN")
  nextAction   String?
  nextActionAt DateTime?
  closedAt     DateTime?
  closeReason  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lead         Lead             @relation(fields: [leadId], references: [id])
  requirement  Requirement?
  visits       Visit[]

  @@index([stage])
  @@map("opportunity")
  @@schema("crm")
}

model Asset {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code                String                @unique @db.VarChar(50)
  name                String                @db.VarChar(150)
  description         String?
  assetType           asset_type            @map("asset_type")
  status              asset_status          @default(DRAFT)
  ownerPartyId        String?               @map("owner_party_id") @db.Uuid
  areaM2              Decimal               @map("area_m2") @db.Decimal(10, 2)
  currency            String                @default("USD") @db.VarChar(3)
  currentPrice        Decimal               @map("current_price") @db.Decimal(12, 2)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  asset_price_history asset_price_history[]
  asset_prices        asset_prices[]
  timeline            AssetTimeline[]
  parties             parties?              @relation(fields: [ownerPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([code], map: "idx_assets_code")
  @@index([ownerPartyId], map: "idx_assets_owner")
  @@index([status], map: "idx_assets_status")
  @@map("assets")
  @@schema("inventory")
}

model AssetTimeline {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  previousStatus String?   @map("previous_status") @db.VarChar(50)
  newStatus      String    @map("new_status") @db.VarChar(50)
  actionType     String    @default("STATUS_CHANGE") @map("action_type") @db.VarChar(50)
  details        String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assetId], map: "idx_asset_timeline_asset_id")
  @@map("asset_timeline")
  @@schema("inventory")
}

model organizations {
  party_id   String   @id @db.Uuid
  legal_name String   @db.VarChar(200)
  trade_name String?  @db.VarChar(200)
  tax_id     String   @unique @db.VarChar(20)
  email      String?  @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  parties    parties  @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tax_id], map: "idx_organizations_tax_id")
  @@schema("core")
}

model parties {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  party_type          party_type
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  organizations       organizations?
  persons             persons?
  asset_price_history asset_price_history[]
  assets              Asset[]

  @@schema("core")
}

model persons {
  party_id   String   @id @db.Uuid
  first_name String   @db.VarChar(100)
  last_name  String   @db.VarChar(100)
  doc_type   String   @db.VarChar(20)
  doc_number String   @unique @db.VarChar(20)
  email      String   @unique @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  parties    parties  @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doc_number], map: "idx_persons_doc_number")
  @@index([email], map: "idx_persons_email")
  @@schema("core")
}

model asset_price_history {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  asset_id   String    @db.Uuid
  price      Decimal   @db.Decimal(12, 2)
  currency   String    @default("USD") @db.VarChar(3)
  valid_from DateTime  @default(now()) @db.Timestamptz(6)
  valid_to   DateTime? @db.Timestamptz(6)
  changed_by String?   @db.Uuid
  reason     String?
  assets     Asset     @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parties    parties?  @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([asset_id], map: "idx_price_history_asset")
  @@schema("inventory")
}

model asset_prices {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id   String    @db.Uuid
  currency   String?   @default("USD") @db.VarChar(3)
  amount     Decimal   @db.Decimal(12, 2)
  is_current Boolean?  @default(true)
  valid_from DateTime? @default(now()) @db.Timestamptz(6)
  valid_to   DateTime? @db.Timestamptz(6)
  assets     Asset     @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("inventory")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  role      UserRole @default(ADVISOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
  @@schema("iam")
}

model Project {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(150)
  description String?
  status      ProjectStatus @default(PLANNING)
  district    String?       @db.VarChar(100)
  city        String?       @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  units       Unit[]

  @@map("projects")
  @@schema("inventory")
}

enum ProjectStatus {
  PLANNING
  PRE_SALE
  CONSTRUCTION
  DELIVERED

  @@schema("inventory")
}

model Unit {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  code         String     @unique @db.VarChar(50)
  name         String     @db.VarChar(150)
  unitType     String     @map("unit_type") @db.VarChar(50)
  areaM2       Decimal    @map("area_m2") @db.Decimal(10, 2)
  bedrooms     Int        @default(0)
  bathrooms    Int        @default(0)
  currentPrice Decimal    @map("current_price") @db.Decimal(12, 2)
  status       UnitStatus @default(AVAILABLE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("units")
  @@schema("inventory")
}

model Requirement {
  id             String           @id @default(cuid())
  opportunityId  String           @unique @map("opportunity_id")
  operationType  String           @map("operation_type") @db.VarChar(20)
  assetType      String           @map("asset_type") @db.VarChar(30)
  zones          String[]         @default([])
  budgetMin      Decimal?         @map("budget_min") @db.Decimal(12, 2)
  budgetMax      Decimal?         @map("budget_max") @db.Decimal(12, 2)
  currency       String           @default("USD") @db.VarChar(3)
  areaMin        Decimal?         @map("area_min") @db.Decimal(10, 2)
  areaMax        Decimal?         @map("area_max") @db.Decimal(10, 2)
  attributes     Json?
  timeHorizon    String?          @map("time_horizon") @db.VarChar(30)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  opportunity    Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("requirement")
  @@schema("crm")
}

model Visit {
  id                String   @id @default(cuid())
  opportunityId     String   @map("opportunity_id")
  assetId           String   @map("asset_id")
  scheduledAt       DateTime @map("scheduled_at")
  status            String   @default("SCHEDULED") @db.VarChar(20)
  notes             String?
  createdBy         String   @map("created_by")
  rescheduleReason  String?  @map("reschedule_reason")
  rescheduledCount  Int      @default(0) @map("rescheduled_count")
  cancelReason      String?  @map("cancel_reason")
  cancelledAt       DateTime? @map("cancelled_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([assetId])
  @@index([scheduledAt])
  @@map("visit")
  @@schema("crm")
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD

  @@schema("inventory")
}

enum UserRole {
  ADVISOR
  ADMIN

  @@schema("iam")
}

enum LeadSource {
  WEB_FORM
  WHATSAPP
  PHONE
  REFERRAL
  OTHER

  @@schema("crm")
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED

  @@schema("crm")
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE

  @@schema("crm")
}

enum PartyType {
  PERSON
  ORGANIZATION

  @@schema("crm")
}

enum OpportunityStage {
  NEW
  QUALIFIED
  VISIT_SCHEDULED
  OFFER
  RESERVATION
  WON
  LOST

  @@schema("crm")
}

enum party_type {
  PERSON
  ORGANIZATION

  @@schema("core")
}

enum asset_status {
  DRAFT
  UNDER_REVIEW
  AVAILABLE
  RESERVED
  SOLD
  IN_REVIEW

  @@schema("inventory")
}

enum asset_type {
  LOT
  APARTMENT
  HOUSE
  COMMERCIAL_SPACE

  @@schema("inventory")
}
model Operation {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String              @unique @db.VarChar(50)
  operationType OperationType       @default(SALE) @map("operation_type")
  stage         OperationStage      @default(RESERVATION_HANDOFF)
  agreedAmount  Decimal             @map("agreed_amount") @db.Decimal(14, 2)
  currency      String              @default("USD") @db.VarChar(3)
  reservationId String?             @unique @map("reservation_id") @db.Uuid
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parties       OperationParty[]
  assets        OperationAsset[]
  handoff       ReservationHandoff?

  @@index([stage])
  @@index([reservationId])
  @@map("operations")
  @@schema("operation")
}

model OperationParty {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String     @map("operation_id") @db.Uuid
  partyId     String     @map("party_id") @db.Uuid
  role        PartyRole
  isPrimary   Boolean    @default(false) @map("is_primary")
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, partyId, role], map: "uq_operation_party_role")
  @@index([partyId])
  @@map("operation_parties")
  @@schema("operation")
}

model OperationAsset {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String     @map("operation_id") @db.Uuid
  assetId     String     @map("asset_id") @db.Uuid
  unitId      String?    @map("unit_id") @db.Uuid
  role        AssetRole  @default(PRIMARY)
  agreedPrice Decimal?   @map("agreed_price") @db.Decimal(14, 2)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, assetId], map: "uq_operation_asset")
  @@index([assetId])
  @@map("operation_assets")
  @@schema("operation")
}

model ReservationHandoff {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId   String    @unique @map("operation_id") @db.Uuid
  reservationId String    @unique @map("reservation_id") @db.Uuid
  snapshotData  Json      @map("snapshot_data")
  handedOffBy   String?   @map("handed_off_by") @db.VarChar(100)
  handedOffAt   DateTime  @default(now()) @map("handed_off_at") @db.Timestamptz(6)
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("reservation_handoffs")
  @@schema("operation")
}

enum OperationType {
  SALE
  RENT

  @@schema("operation")
}

enum OperationStage {
  DRAFT
  RESERVATION_HANDOFF
  DOCUMENT_COLLECTION
  CONTRACT_PENDING
  SIGNING
  SETTLED
  CANCELLED

  @@schema("operation")
}

enum PartyRole {
  BUYER
  SELLER
  LESSOR
  TENANT
  ADVISOR
  LEGAL_REP

  @@schema("operation")
}

enum AssetRole {
  PRIMARY
  PARKING
  STORAGE
  SECONDARY

  @@schema("operation")
}
