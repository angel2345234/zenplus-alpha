generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "crm", "iam", "inventory", "finance", "operation"]
  schemas  = ["core", "crm", "iam", "inventory", "operation"]
}

// ============================================================================
// ESQUEMA: CRM
// ============================================================================

model Lead {
  id            String    @id @default(cuid())
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String?   @map("last_name") @db.VarChar(100)
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  status        String    @default("NEW") @db.VarChar(50)
  source        String?   @db.VarChar(50)
  assignedToId  String?   @map("assigned_to_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  opportunities Opportunity[]

  @@map("leads")
  @@schema("crm")
}

model Opportunity {
  id           String        @id @default(cuid())
  leadId       String        @map("lead_id")
  title        String        @db.VarChar(200)
  stage        String        @default("QUALIFICATION") @db.VarChar(50)
  amount       Decimal?      @db.Decimal(12, 2)
  currency     String        @default("USD") @db.VarChar(3)
  assignedToId String?       @map("assigned_to_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requirement  Requirement?
  visits       Visit[]

  @@map("opportunities")
  @@schema("crm")
}

model Requirement {
  id            String      @id @default(cuid())
  opportunityId String      @unique @map("opportunity_id")
  operationType String      @map("operation_type") @db.VarChar(20)
  assetType     String      @map("asset_type") @db.VarChar(30)
  zones         String[]    @default([])
  budgetMin     Decimal?    @map("budget_min") @db.Decimal(12, 2)
  budgetMax     Decimal?    @map("budget_max") @db.Decimal(12, 2)
  currency      String      @default("USD") @db.VarChar(3)
  areaMin       Decimal?    @map("area_min") @db.Decimal(10, 2)
  areaMax       Decimal?    @map("area_max") @db.Decimal(10, 2)
  attributes    Json?
  timeHorizon   String?     @map("time_horizon") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("requirements")
  @@schema("crm")
}

model Visit {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  scheduledAt   DateTime    @map("scheduled_at")
  status        String      @default("SCHEDULED") @db.VarChar(50)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("visits")
  @@schema("crm")
}

// ============================================================================
// ESQUEMA: INVENTORY
// ============================================================================

model Project {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(200)
  description String?
  location    String?  @db.VarChar(255)
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets      Asset[]

  @@map("projects")
  @@schema("inventory")
}

model Asset {
  id          String   @id @default(cuid())
  projectId   String?  @map("project_id")
  code        String   @unique @db.VarChar(50)
  title       String   @db.VarChar(200)
  type        String   @db.VarChar(50)
  status      String   @default("AVAILABLE") @db.VarChar(50)
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD") @db.VarChar(3)
  area        Decimal? @db.Decimal(10, 2)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  units       Unit[]

  @@map("assets")
  @@schema("inventory")
}

model Unit {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  code      String   @db.VarChar(50)
  floor     Int?
  price     Decimal? @db.Decimal(12, 2)
  status    String   @default("AVAILABLE") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("units")
  @@schema("inventory")
}

model Requirement {
  id             String           @id @default(cuid())
  opportunityId  String           @unique @map("opportunity_id")
  operationType  String           @map("operation_type") @db.VarChar(20)
  assetType      String           @map("asset_type") @db.VarChar(30)
  zones          String[]         @default([])
  budgetMin      Decimal?         @map("budget_min") @db.Decimal(12, 2)
  budgetMax      Decimal?         @map("budget_max") @db.Decimal(12, 2)
  currency       String           @default("USD") @db.VarChar(3)
  areaMin        Decimal?         @map("area_min") @db.Decimal(10, 2)
  areaMax        Decimal?         @map("area_max") @db.Decimal(10, 2)
  attributes     Json?
  timeHorizon    String?          @map("time_horizon") @db.VarChar(30)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  opportunity    Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("requirement")
  @@schema("crm")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  role         String    @default("USER") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
  @@schema("iam")
}

// ============================================================================
// ESQUEMA: FINANCE
// ============================================================================

enum ObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@schema("finance")
}

enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
  VOIDED

  @@schema("finance")
}

enum CommissionStatus {
  CALCULATED
  AUTHORIZED
  SETTLED
  CANCELLED

  @@schema("finance")
}

// ============================================================================
// ESQUEMA: OPERATION
// ============================================================================

model Operation {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String             @unique @db.VarChar(50)
  operationType OperationType      @default(SALE) @map("operation_type")
  stage         OperationStage     @default(RESERVATION_HANDOFF)
  agreedAmount  Decimal            @map("agreed_amount") @db.Decimal(14, 2)
  currency      String             @default("USD") @db.VarChar(3)
  reservationId String?            @unique @map("reservation_id") @db.Uuid
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parties       OperationParty[]
  assets        OperationAsset[]
  handoff       ReservationHandoff?

  @@index([stage])
  @@index([reservationId])
  @@map("operations")
  @@schema("operation")
}

model OperationParty {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  partyId     String    @map("party_id") @db.Uuid
  role        PartyRole
  isPrimary   Boolean   @default(false) @map("is_primary")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, partyId, role], map: "uq_operation_party_role")
  @@index([partyId])
  @@map("operation_parties")
  @@schema("operation")
}

model OperationAsset {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String     @map("operation_id") @db.Uuid
  assetId     String     @map("asset_id") @db.Uuid
  unitId      String?    @map("unit_id") @db.Uuid
  role        AssetRole  @default(PRIMARY)
  agreedPrice Decimal?   @map("agreed_price") @db.Decimal(14, 2)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, assetId], map: "uq_operation_asset")
  @@index([assetId])
  @@map("operation_assets")
  @@schema("operation")
}

model ReservationHandoff {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId   String    @unique @map("operation_id") @db.Uuid
  reservationId String    @unique @map("reservation_id") @db.Uuid
  snapshotData  Json      @map("snapshot_data")
  handedOffBy   String?   @map("handed_off_by") @db.VarChar(100)
  handedOffAt   DateTime  @default(now()) @map("handed_off_at") @db.Timestamptz(6)
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("reservation_handoffs")
  @@schema("operation")
}

enum OperationType {
  SALE
  RENT

  @@schema("operation")
}

enum OperationStage {
  DRAFT
  RESERVATION_HANDOFF
  DOCUMENT_COLLECTION
  CONTRACT_PENDING
  SIGNING
  SETTLED
  CANCELLED

  @@schema("operation")
}

enum PartyRole {
  BUYER
  SELLER
  LESSOR
  TENANT
  ADVISOR
  LEGAL_REP

  @@schema("operation")
}

enum AssetRole {
  PRIMARY
  PARKING
  STORAGE
  SECONDARY

  @@schema("operation")
}
  @@schema("inventory")
}
model Operation {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String              @unique @db.VarChar(50)
  operationType OperationType       @default(SALE) @map("operation_type")
  stage         OperationStage      @default(RESERVATION_HANDOFF)
  agreedAmount  Decimal             @map("agreed_amount") @db.Decimal(14, 2)
  currency      String              @default("USD") @db.VarChar(3)
  reservationId String?             @unique @map("reservation_id") @db.Uuid
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parties       OperationParty[]
  assets        OperationAsset[]
  handoff       ReservationHandoff?
  stageHistory  OperationStageHistory[]
  documentRequirements OperationDocumentRequirement[]
  documents     OperationDocument[]

  @@index([stage])
  @@index([reservationId])
  @@map("operations")
  @@schema("operation")
}

model OperationParty {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String     @map("operation_id") @db.Uuid
  partyId     String     @map("party_id") @db.Uuid
  role        PartyRole
  isPrimary   Boolean    @default(false) @map("is_primary")
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, partyId, role], map: "uq_operation_party_role")
  @@index([partyId])
  @@map("operation_parties")
  @@schema("operation")
}

model OperationAsset {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String     @map("operation_id") @db.Uuid
  assetId     String     @map("asset_id") @db.Uuid
  unitId      String?    @map("unit_id") @db.Uuid
  role        AssetRole  @default(PRIMARY)
  agreedPrice Decimal?   @map("agreed_price") @db.Decimal(14, 2)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, assetId], map: "uq_operation_asset")
  @@index([assetId])
  @@map("operation_assets")
  @@schema("operation")
}

model OperationStageHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId String         @map("operation_id") @db.Uuid
  fromStage   OperationStage? @map("from_stage")
  toStage     OperationStage @map("to_stage")
  changedBy   String         @default("SYSTEM") @map("changed_by") @db.VarChar(100)
  reason      String?
  metadata    Json           @default("{}")
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)
  operation   Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([operationId, changedAt(sort: Desc)], map: "idx_operation_stage_history_operation_time")
  @@map("operation_stage_history")
  @@schema("operation")
}

model AssetCommercialState {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  unitId            String?  @map("unit_id") @db.Uuid
  commercialStatus  String   @map("commercial_status") @db.VarChar(30)
  sourceOperationId String?  @map("source_operation_id") @db.Uuid
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([commercialStatus], map: "idx_asset_commercial_state_status")
  @@index([sourceOperationId], map: "idx_asset_commercial_state_source_operation")
  @@map("asset_commercial_state")
  @@schema("operation")
}

model OperationDocumentRequirement {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId       String         @map("operation_id") @db.Uuid
  requirementCode   String         @map("requirement_code") @db.VarChar(80)
  name              String         @db.VarChar(180)
  description       String?
  requiredForStage  OperationStage? @map("required_for_stage")
  isRequired        Boolean        @default(true) @map("is_required")
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  operation         Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  documents         OperationDocument[]

  @@unique([operationId, requirementCode], map: "uq_operation_document_requirement")
  @@index([operationId, requiredForStage], map: "idx_document_requirements_operation_stage")
  @@map("document_requirements")
  @@schema("operation")
}

model OperationDocument {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId    String   @map("operation_id") @db.Uuid
  requirementId  String?  @map("requirement_id") @db.Uuid
  documentType   String   @map("document_type") @db.VarChar(80)
  title          String   @db.VarChar(180)
  status         String   @default("PENDING") @db.VarChar(24)
  currentVersion Int      @default(0) @map("current_version")
  metadata       Json     @default("{}")
  createdBy      String   @default("SYSTEM") @map("created_by") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  operation      Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  requirement    OperationDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  versions       OperationDocumentVersion[]

  @@index([operationId, status], map: "idx_documents_operation_status")
  @@index([requirementId], map: "idx_documents_requirement")
  @@map("documents")
  @@schema("operation")
}

model OperationDocumentVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  storageProvider  String   @map("storage_provider") @db.VarChar(40)
  storageKey       String   @map("storage_key")
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(150)
  sizeBytes        BigInt   @map("size_bytes")
  checksumSha256   String?  @map("checksum_sha256") @db.Char(64)
  uploadedBy       String   @default("SYSTEM") @map("uploaded_by") @db.VarChar(100)
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document         OperationDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber], map: "uq_document_version")
  @@unique([storageProvider, storageKey], map: "uq_document_storage_key")
  @@index([documentId, versionNumber(sort: Desc)], map: "idx_document_versions_document")
  @@map("document_versions")
  @@schema("operation")
}

model ReservationHandoff {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId   String    @unique @map("operation_id") @db.Uuid
  reservationId String    @unique @map("reservation_id") @db.Uuid
  snapshotData  Json      @map("snapshot_data")
  handedOffBy   String?   @map("handed_off_by") @db.VarChar(100)
  handedOffAt   DateTime  @default(now()) @map("handed_off_at") @db.Timestamptz(6)
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("reservation_handoffs")
  @@schema("operation")
}

enum OperationType {
  SALE
  RENT

  @@schema("operation")
}

enum OperationStage {
  DRAFT
  RESERVATION_HANDOFF
  DOCUMENT_COLLECTION
  CONTRACT_PENDING
  SIGNING
  SETTLED
  CANCELLED

  @@schema("operation")
}

enum PartyRole {
  BUYER
  SELLER
  LESSOR
  TENANT
  ADVISOR
  LEGAL_REP

  @@schema("operation")
}

enum AssetRole {
  PRIMARY
  PARKING
  STORAGE
  SECONDARY

  @@schema("operation")
}
